flowchart TD
    %% Job Hunter scoring process overview.
    %% Render with Mermaid in GitHub, VS Code Mermaid preview, or the local app at /static/diagrams/scoring_process_flow.

    A((Start: Job found)) --> B[Capture job posting]

    B --> C[Prepare the job record<br/>title, company, location, salary, work mode, description]
    C -. Business note .-> Cn[Store structured fields in the database<br/>and keep the raw description separate]

    C --> D{Enough information<br/>to assess?}
    D -- No --> D1[Mark as incomplete / low confidence<br/>do not guess missing details]
    D1 --> Z1((End: Needs review or skipped))

    D -- Yes --> E[Run rule-based checks before AI]
    E -. Business note .-> En[Quick checks run first<br/>to save time and AI cost]

    E --> F{Blocked by a clear rule?}
    F -- Yes --> F1[Reject before AI<br/>record the reason]
    F1 --> Z2((End: Rejected))

    F -- No --> G{Outside the target job family?}
    G -. Business note .-> Gn[Compare the role to the target job family<br/>using O*NET guidance]
    G -- Yes --> G1[Reject before AI<br/>title or taxonomy reason]
    G1 --> Z2

    G -- No / uncertain --> H[Prepare the review packet<br/>structured record + trimmed description]
    H -. Business note .-> Hn[Keep the full description<br/>but present a compact version for review]

    H --> I{Can this be scored<br/>with rules alone?}
    I -- Yes --> J[Create a rule-based assessment<br/>grade + rationale + source]
    I -- No --> K[Send to AI review]

    K --> L[Extract requirements<br/>and match them to candidate strengths]
    J --> L
    L -. Business note .-> Ln[Map job requirements<br/>to known candidate capabilities]

    L --> M{Enough evidence<br/>to score?}
    M -- No --> M1[Use fallback grade<br/>mark coverage as missing]
    M -- Yes --> N[Derive the grade from coverage]

    M1 --> O[Build the frozen score summary]
    N --> O

    O --> P[Apply the grade band limit<br/>keep score within the chosen band]
    P -. Business note .-> Pn[The frozen score is not a percentage<br/>of qualification]

    P --> Q{Any hard blockers<br/>after review?}
    Q -- Yes --> Q1[Apply the blocker penalty<br/>push score near zero]
    Q -- No --> R[Store the final score + explanation]

    Q1 --> R

    R --> S[Adjust display ranking only<br/>freshness, viewed status]
    S -. Business note .-> Sn[Display ranking can change;<br/>the frozen score does not]

    S --> T[Show the ranked job to the user]

    T --> U{User action}
    U -- Apply / save --> U1[Record a positive signal]
    U -- Skip / not for me --> U2[Record a rejection signal]
    U -- Needs correction --> U3[Update profile, rules, or backlog]

    U1 --> V[Learning signal]
    U2 --> V
    U3 --> V
    V -. Business note .-> Vn[Feedback improves future runs<br/>without silently changing scoring]

    V --> W((End: Improves future runs))

    classDef decision fill:#fff3cd,stroke:#b58900,stroke-width:1px;
    classDef endstate fill:#f8d7da,stroke:#842029,stroke-width:1px;
    classDef note fill:#e7f1ff,stroke:#084298,stroke-dasharray: 4 3;

    class D,F,G,I,M,Q,U decision;
    class Z1,Z2,W endstate;
    class Cn,En,Gn,Hn,Ln,Pn,Sn,Vn note;
