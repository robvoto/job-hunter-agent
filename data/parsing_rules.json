{
  "kind": "system_config",
  "name": "parsing_rules",
  "version": 13,
  "stopwords_description": "Common filler words stripped during title parsing and token matching.",
  "stopwords": [
    "a", "an", "and", "the", "to", "for", "of", "in", "on", "with", "by", "from", "into",
    "using", "use", "used", "within", "through", "under", "over", "per", "or", "as", "at",
    "is", "are", "was", "were", "be", "been", "being", "that", "this", "these", "those",
    "will", "would", "can", "could", "should", "may"
  ],
  "title_candidate_leading_verb_blockers_description": "Words that make a title too generic or role-like to treat as a clean title candidate during title extraction.",
  "title_candidate_leading_verb_blockers": [
    "working",
    "helping",
    "involved",
    "role",
    "responsible",
    "supporting",
    "managing",
    "leading",
    "coordinating",
    "performing",
    "delivering"
  ],
  "title_candidate_line_rules_description": "Structural limits used to avoid treating sentence fragments as role titles.",
  "title_candidate_line_rules": {
    "max_length_chars": 80,
    "max_tokens": 7,
    "punctuation_blockers": [
      ".",
      ","
    ]
  },
  "candidate_profile_section_routing_description": "Section labels used to route profile text into primary, secondary, or supplementary evidence buckets.",
  "candidate_profile_section_routing": {
    "default_bucket": "primary_candidate_profile_context",
    "primary_labels": [
      "primary",
      "detailed",
      "current",
      "recent",
      "main",
      "core"
    ],
    "secondary_labels": [
      "supporting",
      "older",
      "secondary",
      "legacy",
      "earlier",
      "previous"
    ],
    "supplementary_labels": [
      "background",
      "optional",
      "extra",
      "additional",
      "note",
      "notes",
      "cert",
      "education"
    ]
  },
  "generic_summary_phrases_description": "Short phrases that usually belong to marketing copy, not job evidence.",
  "generic_summary_phrases": [
    "opportunity to join",
    "fast-paced environment",
    "leading company",
    "great opportunity",
    "asap",
    "urgent",
    "must be based in",
    "full working rights"
  ],
  "salary_indicators_description": "Copy cues that help identify salary text and distinguish annual, daily, and super-inclusive pay wording.",
  "salary_indicators": {
    "superannuation": ["inc super", "pkg", "package", "plus super", "superannuation", "super", "+ super"],
    "daily_rate": ["per day", "daily", "p.d.", "day rate", "/day"],
    "annual_rate": ["p.a.", "per annum", "annually", "/year", "/yr", "base +"]
  },
  "contract_type_indicators_description": "Words that suggest permanent, contract, casual, temp, or part-time engagement.",
  "contract_type_indicators": [
    "contract",
    "perm",
    "permanent",
    "fixed term",
    "casual",
    "temp",
    "full-time",
    "part-time"
  ],
  "desirable_language_indicators_description": "Soft wording that usually marks optional rather than required capabilities.",
  "desirable_language_indicators": [
    "desirable",
    "advantage",
    "plus",
    "preferred",
    "ideally",
    "nice to have",
    "not essential",
    "highly regarded",
    "advantageous",
    "beneficial",
    "highly desirable"
  ],
  "mandatory_language_indicators_description": "Words that usually mean a capability or condition is required.",
  "mandatory_language_indicators": [
    "required",
    "requires",
    "required to",
    "essential",
    "must have",
    "mandatory",
    "need to have",
    "needs to have"
  ],
  "strength_language_indicators_description": "Words that help judge whether capability language is strong or weak.",
  "strength_language_indicators": [
    "strong",
    "extensive",
    "proven",
    "solid",
    "deep",
    "hands[- ]on",
    "expert",
    "demonstrated",
    "advanced"
  ],
  "level_aliases_description": "Normalised aliases used when the app maps evidence strength labels to a shared level system.",
  "level_aliases": {
    "low": "low",
    "weak": "low",
    "basic": "basic",
    "limited": "basic",
    "working": "working",
    "intermediate": "working",
    "strong": "strong",
    "expert": "strong"
  },
  "description_confidence_rules_description": "Signals that help decide whether a description reads like real role content or thin copy.",
  "description_confidence_rules": {
    "section_indicators": [
      "responsibilities",
      "requirements",
      "you will",
      "key duties",
      "about the role",
      "experience with",
      "must have",
      "essential"
    ],
    "coordination_tokens": [
      "coordination",
      "coordinating",
      "reporting",
      "liaise",
      "liaison",
      "administration",
      "scheduling"
    ],
    "min_text_length_chars": 500,
    "min_section_hits": 2,
    "min_bullet_points": 3,
    "min_generic_phrases": 2,
    "min_coordination_tokens": 3
  },
  "matching_context_patterns_description": "Regex fragments and context windows used to judge whether capability mentions read as required or desirable.",
  "matching_context_patterns": {
    "hard_requirement_prefix": "(?:required|essential|must have|mandatory|need to have|needs to have|strongly required)",
    "hard_requirement_suffix": "(?:required|essential|must have|mandatory|need to have|needs to have)",
    "hard_requirement_window_chars": 45,
    "soft_requirement_prefix": "(?:desirable|preferred|advantage|plus|ideally|nice to have|not essential|highly regarded|advantageous|beneficial|highly desirable)",
    "soft_requirement_suffix": "(?:desirable|preferred|advantage|plus|ideally|nice to have|not essential|highly regarded|advantageous|beneficial|highly desirable)",
    "soft_requirement_window_chars": 35,
    "negation_prefix_window_chars": 5
  },
  "salary_extraction_patterns_description": "Regex patterns used to extract salary and rate text from descriptions.",
  "salary_extraction_patterns": [
    "\\$\\s?\\d[\\d,]*(?:\\s*-\\s*\\$?\\s?\\d[\\d,]*)?(?:\\s*(?:\\+?\\s*super|incl\\.?\\s*super|package|p\\.a\\.|per annum|per day|daily rate))?",
    "\\b\\d{2,3}k(?:\\s*-\\s*\\d{2,3}k)?(?:\\s*(?:\\+?\\s*super|incl\\.?\\s*super|package|p\\.a\\.|per annum))?"
  ],
  "salary_package_indicators_description": "Signals that indicate salary wording includes package or superannuation cues.",
  "salary_package_indicators": [
    "incl\\.?\\s*super",
    "including\\s+super",
    "\\+\\s*super",
    "superannuation",
    "package",
    "salary packaging"
  ],
  "seek_posted_age_rules_description": "SEEK-specific posted age text extraction and normalization rules.",
  "seek_posted_age_rules": {
    "card_match_pattern": "\\b(?:today|yesterday|\\d+\\s*[mhdy](?:\\s*ago)?)\\b",
    "explicit_labels": {
      "today": 0,
      "yesterday": 1
    },
    "relative_text_pattern": "^(?P<amount>\\d+)\\s*(?P<unit>[mhdy])(?:\\s*ago)?$",
    "unit_days": {
      "m": 0.0006944444444444445,
      "h": 0.041666666666666664,
      "d": 1,
      "y": 365
    }
  },
  "strength_coefficients": {
    "description": "Strength multipliers for capability rule levels. Used by capability_rule_strength to weight evidence.",
    "default": 0.45,
    "strong": 1.0,
    "working": 0.75,
    "basic": 0.5,
    "low": 0.25
  },
  "government_discovery_config": {
    "government_terms": [
      "government",
      "public sector",
      "public service",
      "dept",
      "council",
      "minister"
    ],
    "clearance_normalization": {
      "baseline": ["baseline", "baseline clearance"],
      "nv1": ["nv1", "nv 1", "negative vetting 1", "negative vetting level 1"],
      "nv2": ["nv2", "nv 2", "negative vetting 2", "negative vetting level 2"],
      "top secret": ["top secret", "ts"],
      "protected": ["protected clearance"]
    }
  },
  "government_discovery_patterns": {
    "aps": "\\baps\\s*(\\d+)\\b",
    "el": "\\bel\\s*(\\d+)\\b",
    "clearance": "\\b(?:baseline|nv\\s*\\d|negative\\s+vetting\\s+\\d|top\\s+secret|protected)\\s*(?:clearance)?\\b|\\bclearance\\s+required\\b",
    "department": "department(?:\\s+of)?\\s+(?:[a-z]+(?:\\s+[a-z]+)*)"
  }
}
