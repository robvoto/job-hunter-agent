{
  "kind": "system_config",
  "name": "posting_channel_indicators",
  "version": 3,
  "posting_channel_indicators_description": "Metadata-first posting channel evidence plus token/window classifier support for recruiter-like wording. Text evidence is now tokenized instead of regex-driven.",
  "posting_channel_indicators": {
    "recruiter_keywords": [
      "recruitment",
      "recruiter",
      "staffing",
      "resourcing",
      "labour hire",
      "labor hire",
      "executive search",
      "search firm"
    ],
    "recruiter_copy_patterns": [
      "our client",
      "on behalf of",
      "client is seeking",
      "contact (?:our )?(?:consultant|recruiter|recruitment team)"
    ],
    "text_classifier": {
      "first_person_terms": [
        "our",
        "we"
      ],
      "client_terms": [
        "client",
        "customer",
        "mandant"
      ],
      "hiring_terms": [
        "seeking",
        "hiring",
        "looking",
        "recruiting",
        "requires",
        "search",
        "searching"
      ],
      "intermediary_phrases": [
        "on behalf of",
        "about the client",
        "one of our clients",
        "one of our federal government clients",
        "recruiting for",
        "engaged by"
      ],
      "plural_normalisations": {
        "clients": "client",
        "customers": "customer"
      }
    },
    "company_indicators": {
      "strong_names": [
        "IT Alliance Australia"
      ],
      "strong_domains": [],
      "strong_terms": [
        "recruitment",
        "recruiter",
        "staffing",
        "resourcing",
        "labour hire",
        "labor hire",
        "executive search",
        "search firm"
      ],
      "weak_terms": [
        "talent"
      ]
    }
  }
}
