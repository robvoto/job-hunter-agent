#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

fail() {
  echo "[sync-job-rejections] ERROR: $1" >&2
  exit 1
}

command -v uv >/dev/null 2>&1 || fail "uv is not installed or not on PATH"
[[ -f .env ]] || fail ".env not found"
[[ -f data/app.db ]] || fail "data/app.db not found"
IMPORT_PATH="$PWD/data/imports/candidate_application_history_export.json"
[[ -f "$IMPORT_PATH" ]] || fail "candidate application history export is missing: $IMPORT_PATH"

export JOB_HUNTER_DB_PATH="${JOB_HUNTER_DB_PATH:-$PWD/data/app.db}"
[[ -f "$JOB_HUNTER_DB_PATH" ]] || fail "JOB_HUNTER_DB_PATH does not exist: $JOB_HUNTER_DB_PATH"

echo "[sync-job-rejections] Preflight..."
uv run --env-file .env python - <<'PY'
from job_hunter_agent.user_context import set_user_context_from_admin_env, get_user_id
set_user_context_from_admin_env()
if not get_user_id():
    raise SystemExit("JOB_HUNTER_ADMIN_EMAIL is missing or could not establish CLI user context")
print("[sync-job-rejections] Source: local JSON export")
PY

# Remove only cached extraction failures from previous unauthenticated CLI runs.
uv run --env-file .env python - <<'PY'
import json
from pathlib import Path
p = Path("data/runtime/candidate_application_history_cache.json")
if not p.exists():
    raise SystemExit(0)
data = json.loads(p.read_text(encoding="utf-8"))
if not isinstance(data, dict):
    raise SystemExit(0)
cleaned = {}
removed = 0
for key, entry in data.items():
    value = entry.get("value", {}) if isinstance(entry, dict) else {}
    reason = str(value.get("llm_review_reason") or "")
    if value.get("llm_needs_review") and reason == "LLM extraction unavailable or invalid":
        removed += 1
        continue
    cleaned[key] = entry
if removed:
    p.write_text(json.dumps(cleaned, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    print(f"[sync-job-rejections] Removed {removed} degraded cached extraction(s)")
PY

echo "[sync-job-rejections] Importing latest rejection history..."
uv run --env-file .env python - <<'PY'
from pathlib import Path

from job_hunter_agent.user_context import set_user_context_from_admin_env
set_user_context_from_admin_env()
from job_hunter_agent.candidate_application_history import import_candidate_rejections_from_json

summary = import_candidate_rejections_from_json(
    Path("data/imports/candidate_application_history_export.json")
)
print(
    "[sync-job-rejections] Imported records: "
    f"{summary['records_added']} added, "
    f"{summary['records_updated']} updated, "
    f"{summary['records_total']} total"
)
PY

echo "[sync-job-rejections] Final local history status..."
uv run --env-file .env python - <<'PY'
from job_hunter_agent.user_context import set_user_context_from_admin_env
set_user_context_from_admin_env()
from job_hunter_agent.candidate_application_history import main
raise SystemExit(main(["status"]))
PY

# HELP: importing rejection emails (above) and updating the "rejected before"
# counts shown on job cards (below) are two separate steps. Skipping this step
# means today's import sits in the file but the numbers you see in the app
# stay frozen at whatever they were last time this ran. This step reads what
# was just imported and rewrites those counts, per employer, in the database.
echo "[sync-job-rejections] Refreshing employer rejection counts..."
uv run --env-file .env python - <<'PY'
from job_hunter_agent.user_context import set_user_context_from_admin_env, get_user_id
set_user_context_from_admin_env()
from job_hunter_agent.employer_outcome_backfill import backfill_from_rejection_history

summary = backfill_from_rejection_history(get_user_id())
print(
    "[sync-job-rejections] Employer counts refreshed: "
    f"{summary['events_imported']} events, "
    f"{summary['employers_in_rollup']} employers, "
    f"{summary['skipped_no_employer']} skipped (no employer), "
    f"{summary['skipped_no_date']} skipped (no date)"
)
PY

echo "[sync-job-rejections] Done."
