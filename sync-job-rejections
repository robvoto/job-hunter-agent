#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

fail() {
  echo "[sync-job-rejections] ERROR: $1" >&2
  exit 1
}

command -v uv >/dev/null 2>&1 || fail "uv is not installed or not on PATH"
[[ -f .env ]] || fail ".env not found"
[[ -f data/app.db ]] || fail "data/app.db not found"
[[ -f data/runtime/rob_candidate_application_history_import.local.json ]] || fail "local rejection-sheet override is missing"

export JOB_HUNTER_DB_PATH="${JOB_HUNTER_DB_PATH:-$PWD/data/app.db}"
[[ -f "$JOB_HUNTER_DB_PATH" ]] || fail "JOB_HUNTER_DB_PATH does not exist: $JOB_HUNTER_DB_PATH"

echo "[sync-job-rejections] Preflight..."
uv run --env-file .env python - <<'PY'
from job_hunter_agent.user_context import set_user_context_from_admin_env, get_user_id
set_user_context_from_admin_env()
if not get_user_id():
    raise SystemExit("JOB_HUNTER_ADMIN_EMAIL is missing or could not establish CLI user context")

from job_hunter_agent.global_settings import (
    is_candidate_application_history_enabled,
    get_candidate_application_history_spreadsheet_id,
    get_candidate_application_history_tab_name,
)

if not is_candidate_application_history_enabled():
    raise SystemExit("Candidate application history is disabled")
if not get_candidate_application_history_spreadsheet_id().strip():
    raise SystemExit("Candidate application history spreadsheet_id is empty")
if not get_candidate_application_history_tab_name().strip():
    raise SystemExit("Candidate application history tab_name is empty")

print(f"[sync-job-rejections] Source configured: {get_candidate_application_history_tab_name()}")
PY

# Remove only cached extraction failures from previous unauthenticated CLI runs.
uv run --env-file .env python - <<'PY'
import json
from pathlib import Path
p = Path("data/runtime/candidate_application_history_cache.json")
if not p.exists():
    raise SystemExit(0)
data = json.loads(p.read_text(encoding="utf-8"))
if not isinstance(data, dict):
    raise SystemExit(0)
cleaned = {}
removed = 0
for key, entry in data.items():
    value = entry.get("value", {}) if isinstance(entry, dict) else {}
    reason = str(value.get("llm_review_reason") or "")
    if value.get("llm_needs_review") and reason == "LLM extraction unavailable or invalid":
        removed += 1
        continue
    cleaned[key] = entry
if removed:
    p.write_text(json.dumps(cleaned, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    print(f"[sync-job-rejections] Removed {removed} degraded cached extraction(s)")
PY

echo "[sync-job-rejections] Importing latest rejection history..."
uv run --env-file .env python - <<'PY'
from job_hunter_agent.user_context import set_user_context_from_admin_env
set_user_context_from_admin_env()
from job_hunter_agent.candidate_application_history import main
raise SystemExit(main(["import-from-sheet"]))
PY

echo "[sync-job-rejections] Final local history status..."
uv run --env-file .env python - <<'PY'
from job_hunter_agent.user_context import set_user_context_from_admin_env
set_user_context_from_admin_env()
from job_hunter_agent.candidate_application_history import main
raise SystemExit(main(["status"]))
PY

echo "[sync-job-rejections] Done."
